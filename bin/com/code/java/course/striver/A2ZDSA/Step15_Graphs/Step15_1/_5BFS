code:

    class Solution{
        public ArrayList<Integer> bfsOfGraph(int v,ArrayList<ArrayList<Integer>> adj){
            ArrayList<Integer> bfs = new ArrayList<>();
            boolean vis[] = new boolean[v];
            Queue<Integer> q = new LinkedList<>();

            q.add(0);
            vis[0]=true;

            while(!q.isEmpty()){
                Integer node = q.poll();
                bfs.add(node);

                for(Integer it:adj.get(node)){
                    if(vis[it]==false){
                        vis[it]=true;
                        q.add(it);
                    }
                }
            }
            return bfs;
        }
    }
    space : O(3N) ~ O(N)
    Time: O(N) + O(2*Edges)